#!/bin/bash
#SBATCH --nodes 1
#SBATCH --cpus-per-task 8
#SBATCH --mem=32G
#SBATCH --time 5-00:00:00
#SBATCH --job-name ingest
#SBATCH --output ./logs/ingest.log

CONFIG="${POWER_CREEP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/power-creep/local.env}"
if [[ -f "$CONFIG" ]]; then source "$CONFIG"; fi

set -euo pipefail
export PYTHONUNBUFFERED=1

REPO="${SLURM_SUBMIT_DIR:-$(pwd)}"
cd "$REPO"

export DB_PATH="$REPO/data/powercreep.duckdb"

PYTHON="${POWER_CREEP_PYTHON:-python3}"

echo "=== ingest starting on $(hostname) at $(date) ==="
echo "DB: $DB_PATH"

$PYTHON "$REPO/scripts/ingest_hsdata.py" --skip-clone --fresh --workers "${SLURM_CPUS_PER_TASK:-8}"

echo "=== Done at $(date) ==="
